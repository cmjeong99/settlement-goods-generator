{
  "name": "settlement-formula-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "vendor:sync": "node scripts/sync-editor-vendor.js",
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --test",
    "build": "node scripts/build.js",
    "preview": "node scripts/preview.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  },
  "dependencies": {
    "prismjs": "1.30.0",
    "sql-formatter": "15.9.0"
  }
}
